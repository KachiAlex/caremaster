rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function allowUpload(uid, maxSizeMb, pattern) {
      return (isOwner(uid) || isAdmin()) &&
             request.resource.size < maxSizeMb * 1024 * 1024 &&
             request.resource.contentType.matches(pattern);
    }

    // Allow users (or admins on their behalf) to upload categorized documents
    match /users/{uid}/documents/{category}/{filename} {
      allow read: if request.auth != null && (isOwner(uid) || isAdmin());
      allow write: if allowUpload(uid, 10, '(application/pdf|image/.*)');
    }

    // Fallback for flat document structure (backwards compatibility)
    match /users/{uid}/documents/{docId} {
      allow read: if request.auth != null && (isOwner(uid) || isAdmin());
      allow write: if allowUpload(uid, 10, '(application/pdf|image/.*)');
    }

    // Profile pictures stored via fileStorageService (users/{uid}/profile-picture/<filename>)
    match /users/{uid}/profile-picture/{fileId} {
      allow read: if true;
      allow write: if allowUpload(uid, 5, 'image/.*');
    }

    // Qualification or certification documents (users/{uid}/qualifications/<filename>)
    match /users/{uid}/qualifications/{fileId} {
      allow read: if request.auth != null && (isOwner(uid) || isAdmin());
      allow write: if allowUpload(uid, 10, '(application/pdf|image/.*|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document)');
    }

    // Legacy profile path
    match /users/{uid}/profile/{fileId} {
      allow read: if true;
      allow write: if allowUpload(uid, 5, 'image/.*');
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}

