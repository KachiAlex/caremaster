# Environment
REACT_APP_ENVIRONMENT=production
REACT_APP_API_BASE_URL=https://getcaremaster.com/api
REACT_APP_API_URL=https://getcaremaster.com/api

# Security Configuration
REACT_APP_ENCRYPTION_KEY=your_encryption_key_here
REACT_APP_JWT_SECRET=your_jwt_secret_here

# Feature Flags
REACT_APP_ENABLE_AI_FEATURES=false
REACT_APP_ENABLE_VOICE_COMMANDS=true
REACT_APP_ENABLE_EMERGENCY_ALERTS=true
REACT_APP_ENABLE_MEDICATION_REMINDERS=true

# Enhanced Security Features
REACT_APP_ENABLE_2FA=false
REACT_APP_ENABLE_BIOMETRIC=false
REACT_APP_ENABLE_ENCRYPTION=true
REACT_APP_ENABLE_AUDIT_LOG=true
REACT_APP_ENABLE_RATE_LIMITING=true

# Development/Testing flags
REACT_APP_USE_EMULATORS=false
REACT_APP_DEBUG_MODE=false

PORT=5000
NODE_ENV=production

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

PAYSTACK_SECRET_KEY=sk_live_your_key
PAYSTACK_PUBLIC_KEY=pk_live_your_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
TOTP_ISSUER=Care Master

# Cloudinary
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name
REACT_APP_CLOUDINARY_UPLOAD_PRESET=your_preset

# Brevo Email
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_brevo_login
BREVO_SMTP_KEY=your_brevo_key
BREVO_FROM_EMAIL=noreply@getcaremaster.com
BREVO_FROM_NAME=Care Master
