# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elderx_app
DB_USER=elderx_user
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# Payment Gateway Configuration (Paystack)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# Server Configuration
PORT=5000
NODE_ENV=development

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# 2FA Configuration
TOTP_ISSUER=Care Master

# WebRTC/TURN Server Configuration (Optional but recommended for production)
# TURN servers enable NAT traversal for video calls behind restrictive firewalls
# If not configured, calls will use only STUN servers (may fail in some networks)
# Example TURN server: coturn (https://github.com/coturn/coturn)
# TURN_SERVER_URL=turn:your-turn-server.com:3478?transport=tcp
# TURN_USERNAME=your_turn_username
# TURN_CREDENTIAL=your_turn_password
# TURN_SERVER_URL2=turn:your-backup-turn-server.com:3478?transport=tcp

# Call Cleanup Configuration
# How often to clean up old signaling records (in hours)
CALL_CLEANUP_INTERVAL_HOURS=6
