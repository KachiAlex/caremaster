{
  "dataconnect": {
    "source": "dataconnect"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "region": "us-central1"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
        "rewrites": [
          {
            "source": "debug-users.html",
            "destination": "/debug-users.html"
          },
          {
            "source": "fix-pharmacist.html",
            "destination": "/fix-pharmacist.html"
          },
          {
            "source": "update-jaypharm.html",
            "destination": "/update-jaypharm.html"
          },
          {
            "source": "check-assignments.html",
            "destination": "/check-assignments.html"
          },
          {
            "source": "session-debug.html",
            "destination": "/session-debug.html"
          },
          {
            "source": "debug-pharmacist-role.html",
            "destination": "/debug-pharmacist-role.html"
          },
          {
            "source": "sw.js",
            "destination": "/sw.js"
          },
          {
            "source": "manifest.json",
            "destination": "/manifest.json"
          },
          {
            "source": "/api/tenants",
            "function": "apiTenants"
          },
          {
            "source": "**",
            "destination": "/index.html"
          }
        ],
    "headers": [
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=0"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000"
          }
        ]
      },
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "manifest.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
