rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Multi-tenant helpers
    function userInstitution() {
      // Try to get institutionId from auth token first, then fall back to user document
      return request.auth != null 
        ? (request.auth.token.institutionId != null 
            ? request.auth.token.institutionId 
            : (exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
                ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId 
                : null))
        : null;
    }
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.superAdmin == true;
    }
    // Institutions: public read (for login/landing pages), write super-admin only
    match /institutions/{institutionId} {
      allow read: if true; // Public read for institution branding on login pages
      allow write: if isSuperAdmin();
    }
    // Licenses: public read (for login/landing pages), write super-admin only
    match /licenses/{licenseId} {
      allow read: if true; // Public read for displaying license status on login pages
      allow write: if isSuperAdmin();
    }
    // Institution admins mapping: super-admin only
    match /institutionAdmins/{docId} {
      allow read, write: if isSuperAdmin();
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.institutionAdmin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionAdmin == true
        ))
      );
    }
    
    // Medical reports - Doctor only can create/update
    match /medicalReports/{reportId} {
      allow read: if isAdmin() || isDoctor() || isCaregiver();
      allow create: if isAdmin() || isDoctor();
      allow update, delete: if isAdmin() || isDoctor();
    }
    
    // Nurse reports
    match /nurseReports/{reportId} {
      allow read: if isAdmin() || isDoctor() || isCaregiver();
      allow create: if isAdmin() || isCaregiver();
      allow update, delete: if isAdmin();
    }

    // Care plans - Doctor only can create/update
    match /carePlans/{planId} {
      allow read: if isAdmin() || isDoctor() || isCaregiver();
      allow create: if isAdmin() || isDoctor();
      allow update, delete: if isAdmin() || isDoctor();
    }

    // Helper: user is caregiver or doctor
    function isCaregiver() {
      return request.auth != null && (
        request.auth.token.caregiver == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'caregiver' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'caregiver' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'caregiver'
      );
    }
    function isDoctor() {
      return request.auth != null && (
        request.auth.token.doctor == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'doctor' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'doctor' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor'
      );
    }
    function isNurse() {
      return request.auth != null && (
        request.auth.token.nurse == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'nurse' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'nurse' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'nurse'
      );
    }
    function isPharmacist() {
      return request.auth != null && (
        request.auth.token.pharmacist == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'pharmacist' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'pharmacist' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pharmacist'
      );
    }
    
    // Users collection - users can read their own data, admins can read/write all
    // Also allow service providers (caregivers/doctors) to read other users for messaging
    // SECURITY FIX: Restricted list queries to authenticated users only with rate limiting
    match /users/{userId} {
      // Allow read by email for login verification (limited scope)
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isCaregiver() || isDoctor());
      // SECURITY FIX: Restrict list queries to authenticated users only
      // List queries must be authenticated and filtered by email in application code
      allow list: if request.auth != null && (
        // Only allow list queries for authentication purposes by authenticated users
        // Application code must filter by email to prevent enumeration
        request.query.limit <= 10  // Rate limiting: max 10 results per query
      );
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // TEMPORARY: Allow authenticated users to update only role-related fields for migration
      allow update: if request.auth != null && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'roleMigrated', 'roleMigratedAt', 'updatedAt']);
    }
    
    // Caregivers collection - caregivers can read their own document and query by institution, admins full access
    match /caregivers/{caregiverId} {
      allow read, list: if isAdmin() || isCaregiver() || isDoctor() || (request.auth != null && request.auth.uid == caregiverId);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == caregiverId);
    }
    
    // Patients collection
    match /patients/{patientId} {
      // Admin full access. Caregivers/doctors/pharmacists can read patients
      allow read, list: if isAdmin() || isCaregiver() || isDoctor() || isPharmacist();
      // Writes restricted to admin
      allow write: if isAdmin();
    }
    
    // Clients collection (same as patients)
    match /clients/{clientId} {
      // Admin full access. Caregivers/doctors/pharmacists can read clients
      // For list queries, allow based on role (resource.data not available in list queries)
      // For document reads, also allow based on institutionId match
      allow read: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() || 
        isPharmacist() || 
        (resource.data != null && resource.data.institutionId == userInstitution())
      );
      allow list: if request.auth != null && (isAdmin() || isCaregiver() || isDoctor() || isPharmacist());
      // Writes restricted to authenticated admin
      allow create: if request.auth != null && isAdmin();
      allow update, delete: if request.auth != null && isAdmin();
    }
    
    // Client assignments
    match /clientAssignments/{assignmentId} {
      allow read, list: if isAdmin() || (request.auth != null && (isCaregiver() || isPharmacist()));
      allow write: if isAdmin();
    }
    
    // Assignments collection - for caregiver assignments and tasks
    match /assignments/{assignmentId} {
      allow read, list: if isAdmin() || (request.auth != null && (isCaregiver() || isDoctor()));
      allow write: if isAdmin() || (request.auth != null && (isCaregiver() || isDoctor()));
    }
    
    // Medical history
    match /medicalHistory/{historyId} {
      allow read: if isAdmin() || isCaregiver() || isDoctor();
      allow write: if isAdmin() || isDoctor();
    }
    
    // Care tasks assigned to caregivers/doctors
    match /careTasks/{taskId} {
      // Allow read for the assignee whether caregiver or doctor
      // For list queries with caregiverId filter, allow if authenticated caregiver/doctor
      allow read, list: if isAdmin() || (request.auth != null && (isCaregiver() || isDoctor()));
      // Allow updates by the assignee (caregiver/doctor) for status-only changes
      allow update: if (isCaregiver() || isDoctor()) && resource.data.caregiverId == request.auth.uid;
      allow create, delete: if isAdmin();
    }
    
    // Task time tracking collection - caregivers can create tracking records for their tasks
    match /taskTimeTracking/{trackingId} {
      allow read, list: if isAdmin() || (request.auth != null && (
        isCaregiver() || isDoctor() || 
        resource.data.caregiverId == request.auth.uid
      ));
      allow create: if request.auth != null && (
        isAdmin() || 
        (isCaregiver() || isDoctor()) && request.resource.data.caregiverId == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        request.auth != null && 
        (isCaregiver() || isDoctor()) && 
        resource.data.caregiverId == request.auth.uid
      );
    }
    
    // Analytics events - admin only
    match /analyticsEvents/{eventId} {
      allow create, read, list: if isAdmin();
      allow update, delete: if false;
    }
    
    // Patient-caregiver assignments: caregivers can read their own
    match /patientAssignments/{assignmentId} {
      allow read, list: if isAdmin() || (request.auth != null && isCaregiver());
      allow write: if isAdmin();
    }
    
    // Caregiver assignments (alternative collection name)
    match /caregiverAssignments/{assignmentId} {
      allow read: if isAdmin() || (request.auth != null && isCaregiver());
      allow write: if isAdmin();
    }
    
    match /alerts/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /vitalSigns/{document=**} {
      // Allow read for assigned caregivers/doctors via patient linkage if denormalized fields exist
      allow read: if isAdmin() || isCaregiver() || isDoctor();
      allow write: if isAdmin();
    }
    
    // Appointments: caregivers/doctors/patients can read their own
    match /appointments/{appointmentId} {
      // For document reads, allow based on role or ownership
      allow read: if isAdmin() || (
        request.auth != null && (
          isCaregiver() || isDoctor() ||
          (resource.data != null && (
            resource.data.caregiverId == request.auth.uid ||
            resource.data.doctorId == request.auth.uid ||
            resource.data.patientId == request.auth.uid
          ))
        )
      );
      // For list queries, allow based on role (resource.data not available)
      allow list: if isAdmin() || (request.auth != null && (isCaregiver() || isDoctor()));
      allow write: if isAdmin();
    }
    
    // Assignment requests
    match /assignmentRequests/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Messages collection - allow authenticated users to read/write messages
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow users to query messages collection
    match /messages {
      allow read: if request.auth != null;
    }
    
    // Conversations collection - allow authenticated users to read/write conversations
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null;
    }
    
    // Task assignments
    match /taskAssignments/{assignmentId} {
      allow read: if isAdmin() || (isCaregiver() && resource.data.caregiverId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    
    // Nurse assignments
    match /nurseAssignments/{assignmentId} {
      allow read: if isAdmin() || (isCaregiver() && resource.data.nurseId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    
    // Telemedicine appointments
    match /telemedicine_appointments/{appointmentId} {
      allow read: if isAdmin() || (
        request.auth != null && (
          resource.data.nurseId == request.auth.uid ||
          resource.data.doctorId == request.auth.uid ||
          resource.data.patientId == request.auth.uid
        )
      );
      allow write: if isAdmin() || isDoctor() || isCaregiver();
    }
    
    // Telemedicine calls
    match /telemedicine_calls/{callId} {
      allow read: if isAdmin() || (
        request.auth != null && (
          resource.data.nurseId == request.auth.uid ||
          resource.data.doctorId == request.auth.uid ||
          resource.data.patientId == request.auth.uid
        )
      );
      allow write: if isAdmin() || isDoctor() || isCaregiver();
    }
    
    // Emergency alerts
    match /emergencies/{emergencyId} {
      allow read, list: if isAdmin() || isDoctor() || isCaregiver();
      allow create: if isAdmin() || isDoctor() || isCaregiver();
      allow update: if isAdmin() || isDoctor();
    }
    
    // Emergency protocols
    match /emergencyProtocols/{protocolId} {
      allow read: if isAdmin() || isDoctor() || isCaregiver();
      allow write: if isAdmin() || isDoctor();
    }
    
    // Notifications collection - users can read/write their own notifications
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null && (
        isAdmin() || 
        request.resource.data.userId == request.auth.uid
      );
      allow update: if request.auth != null && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
    }
    
    // Calls collection - allow authenticated users to read/write calls
    match /calls/{callId} {
      allow read, write: if request.auth != null;
    }
    
    // Call notifications collection - allow authenticated users to read/write call notifications
    match /callNotifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
    
    // User status collection - allow authenticated users to read/write status
    match /userStatus/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Care logs collection - caregivers can create logs; authenticated users can read
    match /careLogs/{logId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        (resource.data != null && resource.data.caregiverId == request.auth.uid) ||
        (resource.data != null && resource.data.institutionId == userInstitution())
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        isAdmin() || 
        (request.resource.data != null && request.auth.uid == request.resource.data.caregiverId)
      );
    }

    // Medications collection - patients can read their own; caregivers/doctors can read; providers can create
    match /medications/{medicationId} {
      // Allow reads for:
      // - Admins
      // - Doctors/Caregivers (service providers)
      // - Pharmacists (for pharmacy management)
      // - The patient who owns the record (by patientId)
      allow read, list: if request.auth != null && (
        isAdmin() || isDoctor() || isCaregiver() || isPharmacist() ||
        (resource.data != null && resource.data.patientId == request.auth.uid)
      );

      // Allow creates for admins, doctors, and caregivers
      allow create: if request.auth != null && (isAdmin() || isDoctor() || isCaregiver());

      // Allow updates/deletes for admins and doctors
      allow update, delete: if request.auth != null && (isAdmin() || isDoctor());
    }
    
    // Medication logs for compliance tracking
    match /medicationLogs/{logId} {
      allow read, list: if isAdmin() || isCaregiver() || isDoctor();
      allow create: if isAdmin() || isCaregiver();
      allow update, delete: if isAdmin();
    }
    
    // Dose logs
    match /doseLogs/{doseId} {
      allow read, list: if isAdmin() || isCaregiver() || isDoctor();
      allow create: if isAdmin() || isCaregiver();
      allow update, delete: if isAdmin() || isCaregiver();
    }
    
    // Side effects reporting
    match /sideEffects/{effectId} {
      allow read, list: if isAdmin() || isCaregiver() || isDoctor();
      allow create: if isAdmin() || isCaregiver() || isDoctor();
      allow update, delete: if isAdmin() || isDoctor();
    }

    // Patient feedback collection - caregivers can read their own feedback; admins manage
    match /patientFeedback/{feedbackId} {
      // Caregivers can read feedback where they are the subject
      allow read: if request.auth != null && (
        isAdmin() || resource.data.caregiverId == request.auth.uid
      );

      // Only admins can create/update/delete patient feedback
      allow create, update, delete: if isAdmin();
    }
    
    // Client reports collection
    match /clientReports/{reportId} {
      allow read, list: if isAdmin() || isCaregiver() || isDoctor();
      allow create: if isAdmin() || isCaregiver() || isDoctor();
      allow update, delete: if isAdmin();
    }
    
    // Client care logs collection
    match /clientCareLogs/{logId} {
      allow read, list: if isAdmin() || isCaregiver() || isDoctor();
      allow create: if isAdmin() || isCaregiver();
      allow update, delete: if isAdmin();
    }
    
    // Patient reports collection (similar to clientReports)
    match /patientReports/{reportId} {
      allow read, list: if isAdmin() || isCaregiver() || isDoctor();
      allow create: if isAdmin() || isCaregiver() || isDoctor();
      allow update, delete: if isAdmin();
    }
    
    // Patient care logs collection (similar to clientCareLogs)
    match /patientCareLogs/{logId} {
      allow read, list: if isAdmin() || isCaregiver() || isDoctor();
      allow create: if isAdmin() || isCaregiver();
      allow update, delete: if isAdmin();
    }
    
    // Caregiver performance tracking
    match /caregiverPerformance/{performanceId} {
      allow read: if isAdmin() || (request.auth != null && isCaregiver());
      allow write: if isAdmin();
    }
    
    // Caregiver schedule
    match /caregiverSchedule/{scheduleId} {
      allow read: if isAdmin() || (request.auth != null && isCaregiver());
      allow write: if isAdmin() || (isCaregiver() && resource.data.caregiverId == request.auth.uid);
    }
    
    // Caregiver clock records
    match /caregiverClockRecords/{recordId} {
      allow read: if isAdmin() || (request.auth != null && isCaregiver());
      allow create: if isAdmin() || (isCaregiver() && request.resource.data.caregiverId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    
    // Caregiver earnings
    match /caregiverEarnings/{earningId} {
      allow read: if isAdmin() || (request.auth != null && isCaregiver() && resource.data.caregiverId == request.auth.uid);
      allow write: if isAdmin();
    }
    
    // Caregiver activity log
    match /caregiverActivityLog/{logId} {
      allow read: if isAdmin() || (request.auth != null && isCaregiver());
      allow create: if request.auth != null && (isAdmin() || isCaregiver());
      allow update, delete: if isAdmin();
    }
    
    // Caregiver activities collection - caregivers can create and read their own activities
    match /caregiverActivities/{activityId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        resource.data.caregiverId == request.auth.uid
      );
      allow create: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor()
      );
      allow update, delete: if request.auth != null && (
        isAdmin() || 
        resource.data.caregiverId == request.auth.uid
      );
    }
    
    // Prescriptions collection - doctors create, all can read, pharmacists can verify
    match /prescriptions/{prescriptionId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        isPharmacist() ||
        resource.data.clientId == request.auth.uid
      );
      allow create: if request.auth != null && (
        isAdmin() || 
        isDoctor()
      );
      allow update: if request.auth != null && (
        isAdmin() || 
        isDoctor() ||
        isPharmacist()
      );
      allow delete: if request.auth != null && (
        isAdmin() || 
        resource.data.doctorId == request.auth.uid
      );
    }
    
    // Prescription items collection - linked to prescriptions
    match /prescriptionItems/{itemId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        isPharmacist()
      );
      allow create: if request.auth != null && (
        isAdmin() || 
        isDoctor()
      );
      allow update: if request.auth != null && (
        isAdmin() || 
        isDoctor() ||
        isPharmacist()
      );
      allow delete: if request.auth != null && (
        isAdmin() || 
        isDoctor()
      );
    }
    
    // Consultations collection - doctors create, all can read (except private notes)
    match /consultations/{consultationId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        resource.data.clientId == request.auth.uid
      );
      allow create: if request.auth != null && (
        isAdmin() || 
        isDoctor()
      );
      allow update, delete: if request.auth != null && (
        isAdmin() || 
        resource.data.doctorId == request.auth.uid
      );
    }
    
    // Pharmacist medication data - pharmacists can manage their own data
    match /pharmacistMedicationData/{dataId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isDoctor() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'pharmacist'
      );
      allow create, update: if request.auth != null && (
        isAdmin() || 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'pharmacist' && 
         request.resource.data.pharmacistId == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        isAdmin() || 
        resource.data.pharmacistId == request.auth.uid
      );
    }
    
    // Inventory collection - admins can manage inventory items
    match /inventory/{itemId} {
      allow read, list: if request.auth != null && (isAdmin() || isCaregiver() || isDoctor());
      allow create, update, delete: if isAdmin();
    }
    
    // Invoices collection - admins can manage invoices
    match /invoices/{invoiceId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        resource.data.clientId == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
    }
    
    // Client supplies tracking
    match /clientSupplies/{supplyId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        resource.data.clientId == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
    }
    
    // Diagnostics collection - role-based access
    match /diagnostics/{diagnosticId} {
      // For document reads, allow based on role or ownership
      allow read: if request.auth != null && (
        isAdmin() || 
        isDoctor() || 
        isNurse() ||
        (resource.data != null && resource.data.clientId == request.auth.uid) ||
        (resource.data != null && resource.data.institutionId == userInstitution())
      );
      // For list queries, allow based on role (resource.data not available)
      allow list: if request.auth != null && (isAdmin() || isDoctor() || isNurse());
      allow create: if request.auth != null && (isAdmin() || isDoctor());
      allow update: if request.auth != null && (
        isAdmin() || 
        (resource.data != null && isDoctor() && resource.data.orderedBy == request.auth.uid) ||
        (resource.data != null && isNurse() && resource.data.orderedBy == request.auth.uid)
      );
      allow delete: if request.auth != null && (isAdmin() || isDoctor());
    }
    
    // Client activities tracking
    match /clientActivities/{activityId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        resource.data.clientId == request.auth.uid
      );
      allow create, update, delete: if request.auth != null && (
        isAdmin() || isCaregiver() || isDoctor()
      );
    }
    
    // Pharmacy inventory collection - pharmacists can manage inventory in their institution
    match /pharmacyInventory/{inventoryId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isPharmacist() ||
        isDoctor()
      );
      allow create, update, delete: if request.auth != null && (
        isAdmin() || 
        isPharmacist()
      );
    }
    
    // Pharmacy invoices collection - pharmacists can manage invoices in their institution
    match /pharmacyInvoices/{invoiceId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isPharmacist() ||
        resource.data.clientId == request.auth.uid
      );
      allow create, update, delete: if request.auth != null && (
        isAdmin() || 
        isPharmacist()
      );
    }
    
    // Pharmacists collection - pharmacists can read their own data
    match /pharmacists/{pharmacistId} {
      allow read, list: if isAdmin() || isPharmacist() || (request.auth != null && request.auth.uid == pharmacistId);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == pharmacistId);
    }
    
    // Signaling collection - for WebRTC call signaling
    match /signaling/{signalingId} {
      // Allow authenticated users to read signaling messages for their calls
      allow read, list: if request.auth != null;
      // Allow authenticated users to create signaling messages for their calls
      allow create: if request.auth != null;
      // Allow users to delete their own signaling messages (cleanup)
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
    }
    
    // Client activities collection - comprehensive logging
    match /clientActivities/{activityId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        isPharmacist() ||
        isNurse() ||
        resource.data.clientId == request.auth.uid
      );
      allow create: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        isPharmacist() ||
        isNurse()
      );
      allow update, delete: if request.auth != null && isAdmin();
    }
    
    // Notifications collection - system notifications
    match /notifications/{notificationId} {
      allow read, list: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        isPharmacist() ||
        isNurse()
      );
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || // User can mark as read
        isAdmin() // Admin can manage all notifications
      );
      allow delete: if request.auth != null && isAdmin();
    }
    
    // ADL Logs - Activities of Daily Living logging
    match /adlLogs/{logId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        isNurse() ||
        resource.data.clientId == request.auth.uid
      );
      allow create: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        isNurse()
      );
      allow update, delete: if request.auth != null && (
        isAdmin() || 
        resource.data.caregiverId == request.auth.uid
      );
    }
    
    // Schedules collection - For scheduling module
    match /schedules/{scheduleId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        isNurse()
      );
      allow create, update, delete: if request.auth != null && isAdmin();
    }
    
    // Support Tickets - Help & support system
    match /supportTickets/{ticketId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin();
    }

    // Patient logs collection - for comprehensive patient activity logging
    match /patientLogs/{logId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        isPharmacist() ||
        (resource.data != null && resource.data.clinicianId == request.auth.uid)
      );
      allow create: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        isPharmacist()
      );
      allow update, delete: if request.auth != null && isAdmin();
    }

    // Audit logs collection - for system audit logging
    match /auditLogs/{logId} {
      allow read, list: if request.auth != null && isAdmin();
      allow create: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        isDoctor() ||
        isPharmacist()
      );
      allow update, delete: if request.auth != null && isAdmin();
    }

    // Caregiver assignments collection (alternative name)
    match /caregiverAssignments/{assignmentId} {
      allow read, list: if request.auth != null && (
        isAdmin() || 
        isCaregiver() || 
        (resource.data != null && resource.data.caregiverId == request.auth.uid)
      );
      allow write: if request.auth != null && isAdmin();
    }

    // Allow admins to read/write any other collections
    match /{document=**} {
      allow read, write: if request.auth != null && isAdmin();
    }
  }
}