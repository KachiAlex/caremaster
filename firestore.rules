rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Multi-tenant helpers
    function userInstitution() {
      return request.auth != null ? request.auth.token.institutionId : null;
    }
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.superAdmin == true;
    }
    function licenseActive() {
      // License enforcement via cached flag on institution doc
      // Institutions should be updated by backend when license changes
      return exists(/databases/$(database)/documents/institutions/$(userInstitution())) &&
             get(/databases/$(database)/documents/institutions/$(userInstitution())).data.active == true;
    }

    // Tenant isolation guard: collections with institutionId must match caller's institution
    function belongsToCaller(resourceData) {
      return resourceData.institutionId == userInstitution();
    }

    // Institutions: public read (for login/landing pages), write super-admin only
    match /institutions/{institutionId} {
      allow read: if true; // Public read for institution branding on login pages
      allow write: if isSuperAdmin();
    }
    // Licenses: public read (for login/landing pages), write super-admin only
    match /licenses/{licenseId} {
      allow read: if true; // Public read for displaying license status on login pages
      allow write: if isSuperAdmin();
    }
    // Institution admins mapping: super-admin only
    match /institutionAdmins/{docId} {
      allow read, write: if isSuperAdmin();
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.admin == true || 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin');
    }
    
    // Nurse reports
    match /nurseReports/{reportId} {
      allow read: if isAdmin() || isDoctor() || isCaregiver();
      allow create: if isAdmin() || isCaregiver();
      allow update, delete: if isAdmin();
    }

    // Care plans
    match /carePlans/{planId} {
      allow read: if isAdmin() || isDoctor() || isCaregiver();
      allow create: if isAdmin() || isDoctor();
      allow update, delete: if isAdmin() || isDoctor();
    }

    // Helper: user is caregiver or doctor
    function isCaregiver() {
      return request.auth != null && (
        request.auth.token.caregiver == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'caregiver' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'caregiver'
      );
    }
    function isDoctor() {
      return request.auth != null && (
        request.auth.token.doctor == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'doctor' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'doctor'
      );
    }
    
    // Helpers: assignment checks based on denormalized fields on the resource
    function isAssignedCaregiverToResource() {
      return (
        resource.data.assignedCaregiver == request.auth.uid ||
        (resource.data.assignedCaregivers != null && request.auth.uid in resource.data.assignedCaregivers)
      );
    }
    function isAssignedDoctorToResource() {
      return resource.data.assignedDoctor == request.auth.uid;
    }
    
    // Users collection - users can read their own data, admins can read/write all
    // Also allow service providers (caregivers/doctors) to read other users for messaging
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin() || isCaregiver() || isDoctor());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Caregivers collection - caregivers can read their own document, admins full access
    match /caregivers/{caregiverId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == caregiverId);
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == caregiverId);
    }
    
    // Patients collection
    match /patients/{patientId} {
      // Admin full access. Caregivers/doctors can read patients assigned to them via denormalized fields
      // Also allow caregivers to read patients if they have tasks assigned to them
      allow read: if licenseActive() && (isAdmin() || 
                    (isCaregiver() && isAssignedCaregiverToResource()) || 
                    (isDoctor() && isAssignedDoctorToResource()) ||
                    (isCaregiver() && request.auth != null));
      // Writes restricted to admin
      allow write: if licenseActive() && isAdmin();
    }
    
    // Care tasks assigned to caregivers/doctors
    match /careTasks/{taskId} {
      // Allow read for the assignee whether caregiver or doctor
      allow read: if licenseActive() && (isAdmin() || (request.auth != null && (isCaregiver() || isDoctor())));
      // Allow updates by the assignee (caregiver/doctor) for status-only changes
      allow update: if licenseActive() && (isCaregiver() || isDoctor()) && resource.data.caregiverId == request.auth.uid;
      allow create, delete: if licenseActive() && isAdmin();
    }
    
    // Patient-caregiver assignments: caregivers can read their own
    match /patientAssignments/{assignmentId} {
      allow read: if licenseActive() && (isAdmin() || (request.auth != null && isCaregiver()));
      allow write: if licenseActive() && isAdmin();
    }
    
    // Caregiver assignments (alternative collection name)
    match /caregiverAssignments/{assignmentId} {
      allow read: if isAdmin() || (request.auth != null && isCaregiver());
      allow write: if isAdmin();
    }
    
    match /alerts/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /vitalSigns/{document=**} {
      // Allow read for assigned caregivers/doctors via patient linkage if denormalized fields exist
      allow read: if licenseActive() && (isAdmin() || isCaregiver() || isDoctor());
      allow write: if licenseActive() && isAdmin();
    }
    
    // Appointments: caregivers/doctors/patients can read their own
    match /appointments/{appointmentId} {
      allow read: if licenseActive() && (isAdmin() || (
        request.auth != null && (
          resource.data.caregiverId == request.auth.uid ||
          resource.data.doctorId == request.auth.uid ||
          resource.data.patientId == request.auth.uid
        )
      ));
      allow write: if licenseActive() && isAdmin();
    }
    
    // Assignment requests
    match /assignmentRequests/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Messages collection - allow authenticated users to read/write messages
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow users to query messages collection
    match /messages {
      allow read: if request.auth != null;
    }
    
    // Conversations collection - allow authenticated users to read/write conversations
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null;
    }
    
    // Task assignments
    match /taskAssignments/{assignmentId} {
      allow read: if isAdmin() || (isCaregiver() && resource.data.caregiverId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    
    // Nurse assignments
    match /nurseAssignments/{assignmentId} {
      allow read: if isAdmin() || (isCaregiver() && resource.data.nurseId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    
    // Telemedicine appointments
    match /telemedicine_appointments/{appointmentId} {
      allow read: if isAdmin() || (
        request.auth != null && (
          resource.data.nurseId == request.auth.uid ||
          resource.data.doctorId == request.auth.uid ||
          resource.data.patientId == request.auth.uid
        )
      );
      allow write: if isAdmin() || isDoctor() || isCaregiver();
    }
    
    // Telemedicine calls
    match /telemedicine_calls/{callId} {
      allow read: if isAdmin() || (
        request.auth != null && (
          resource.data.nurseId == request.auth.uid ||
          resource.data.doctorId == request.auth.uid ||
          resource.data.patientId == request.auth.uid
        )
      );
      allow write: if isAdmin() || isDoctor() || isCaregiver();
    }
    
    // Emergency alerts
    match /emergencies/{emergencyId} {
      allow read: if isAdmin() || isDoctor() || isCaregiver();
      allow create: if isAdmin() || isDoctor() || isCaregiver();
      allow update: if isAdmin() || isDoctor();
    }
    
    // Emergency protocols
    match /emergencyProtocols/{protocolId} {
      allow read: if isAdmin() || isDoctor() || isCaregiver();
      allow write: if isAdmin() || isDoctor();
    }
    
    // Notifications collection - users can read/write their own notifications
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null && (
        isAdmin() || 
        request.resource.data.userId == request.auth.uid
      );
      allow update: if request.auth != null && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
    }
    
    // Calls collection - allow authenticated users to read/write calls
    match /calls/{callId} {
      allow read, write: if request.auth != null;
    }
    
    // Call notifications collection - allow authenticated users to read/write call notifications
    match /callNotifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
    
    // User status collection - allow authenticated users to read/write status
    match /userStatus/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Care logs collection - caregivers can create logs; authenticated users can read
    match /careLogs/{logId} {
      allow read: if licenseActive() && request.auth != null;
      allow create: if licenseActive() && request.auth != null;
      allow update, delete: if licenseActive() && request.auth != null && (
        isAdmin() || request.auth.uid == request.resource.data.caregiverId
      );
    }

    // Medications collection - patients can read their own; caregivers/doctors can read; providers can create
    match /medications/{medicationId} {
      // Allow reads for:
      // - Admins
      // - Doctors/Caregivers (service providers)
      // - The patient who owns the record (by patientId)
      allow read: if licenseActive() && request.auth != null && (
        isAdmin() || isDoctor() || isCaregiver() ||
        (request.resource == null && resource.data.patientId == request.auth.uid) ||
        (request.resource != null && request.resource.data.patientId == request.auth.uid)
      );

      // Allow creates for admins, doctors, and caregivers
      allow create: if licenseActive() && request.auth != null && (isAdmin() || isDoctor() || isCaregiver());

      // Allow updates/deletes for admins and doctors
      allow update, delete: if licenseActive() && request.auth != null && (isAdmin() || isDoctor());
    }

    // Patient feedback collection - caregivers can read their own feedback; admins manage
    match /patientFeedback/{feedbackId} {
      // Caregivers can read feedback where they are the subject
      allow read: if request.auth != null && (
        isAdmin() || resource.data.caregiverId == request.auth.uid
      );

      // Only admins can create/update/delete patient feedback
      allow create, update, delete: if isAdmin();
    }
    
    // Allow admins to read/write any other collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}