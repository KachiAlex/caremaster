rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             (request.auth.token.admin == true || 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin');
    }
    
    // Users collection - users can read their own data, admins can read/write all
    match /users/{userId} {
      allow read: if request.auth != null && 
                    (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && 
                     (request.auth.uid == userId || isAdmin());
    }
    
    // Admin-only collections - only admins can access
    match /caregivers/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /patients/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /tasks/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /patientAssignments/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /alerts/{document=**} {
      allow read, write: if isAdmin();
    }
    
    match /vitalSigns/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Assignment requests
    match /assignmentRequests/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Allow admins to read/write any other collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}